# Production build defaults (ZIP/static-host builds have no .env.local).
# Demo exploration stays OFF unless a higher-precedence source enables it:
# process env (shell/Vercel) > .env.local > this file > .env.
# The empty value here makes webpack dead-code-eliminate the demo entry from
# production bundles even when no other env file exists.
REACT_APP_ENABLE_DEMO=
