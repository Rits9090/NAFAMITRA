# NafaMitra frontend environment template (CRA → REACT_APP_* at build time).
#
# Copy to .env.local for local development, or set these in the Vercel
# project settings (Settings → Environment Variables) for deployments.
# These values are PUBLIC (they ship in the browser bundle) — never put
# database passwords, service-role/secret keys, or SMTP credentials here.

# Supabase project URL (Settings → API in the Supabase dashboard)
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase publishable (anon) key — safe for client-side use; enforce RLS
REACT_APP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: only define in non-production builds to include the labeled demo
# explorer used by automated test suites. Leave UNSET in production.
# REACT_APP_ENABLE_DEMO=1
